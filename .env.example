# Copy to .env and fill in values. Never commit .env.

# ── HTTP ───────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (docker compose up):
DATABASE_URL=postgres://courtscore:courtscore@localhost:5432/courtscore?sslmode=disable
# Prod (api.court-score.com sunucusunda):
# DATABASE_URL=postgres://user:pass@your-db-host:5432/courtscore?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Use different secrets for local and prod!
JWT_SECRET=change_me_to_a_random_32+_char_secret

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Same client IDs for both local and prod (same Google project).
# Android + Web + iOS client IDs (comma-separated, no spaces).
GOOGLE_CLIENT_IDS=620640306728-mlgnptjcl2qsoh6seha3p100r73pruol.apps.googleusercontent.com,620640306728-et295k0iid88m0u6o6sk91fjivvkukrj.apps.googleusercontent.com,620640306728-k6rggqmdjlkh7bb241hjpbd753q6fdeo.apps.googleusercontent.com,620640306728-trqa72aadfsu7taj5lujlfodpv5l5s8k.apps.googleusercontent.com

# ── CORS ───────────────────────────────────────────────────────────────────────
# Local: * (all origins)
# Prod with WebCourtScore: allow the web origin(s). Mobile clients send no Origin.
# Example:
# CORS_ORIGINS=https://court-score.com,https://www.court-score.com,http://localhost:5173
CORS_ORIGINS=*

# ── Firebase Cloud Messaging (optional) ───────────────────────────────────────
# Service-account JSON for FCM HTTP v1. When unset/unreadable, push is a no-op.
#
# Docker (recommended): copy the Admin SDK JSON to secrets/firebase-adminsdk.json
# Compose mounts it at /run/secrets/firebase.json and overrides ADC inside the
# container. Host-only paths like /Users/... will NOT work in Docker.
#
# Local `go run` (optional):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-adminsdk.json
#
# Or paste JSON (takes precedence over the file path):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

