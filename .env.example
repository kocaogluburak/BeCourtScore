# Copy to .env and fill in values. Never commit .env.

# ── HTTP ───────────────────────────────────────────────────────────────────────
PORT=8080

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (docker compose up):
DATABASE_URL=postgres://courtscore:courtscore@localhost:5432/courtscore?sslmode=disable
# Prod (api.court-score.com sunucusunda):
# DATABASE_URL=postgres://user:pass@your-db-host:5432/courtscore?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# Use different secrets for local and prod!
JWT_SECRET=change_me_to_a_random_32+_char_secret

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Same client IDs for both local and prod (same Google project, same Android SHA-1).
# Android client ID + Web client ID (comma-separated, no spaces).
GOOGLE_CLIENT_IDS=620640306728-et295k0iid88m0u6o6sk91fjivvkukrj.apps.googleusercontent.com,620640306728-k6rggqmdjlkh7bb241hjpbd753q6fdeo.apps.googleusercontent.com

# ── CORS ───────────────────────────────────────────────────────────────────────
# Local: * (all origins)
# Prod: sadece backend domain'in varsa kısıtla, mobil API'de origin yoktur
CORS_ORIGINS=*
